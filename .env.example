# ==============================================================================
# SIKONI — Environment Variables Configuration
# ==============================================================================

NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://sikoni_user:sikoni_pass@localhost:5432/sikoni_db?schema=public"

# Authentication & JWT
JWT_SECRET="sikoni_super_secret_jwt_key_surakarta_2026_change_in_production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="sikoni_refresh_secret_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# Private S3-Compatible Object Storage (MinIO / AWS S3)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET_DOCUMENTS="sikoni-documents-private"
STORAGE_BUCKET_RECEIPTS="sikoni-receipts-private"
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900

# Push Notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID="sikoni-surakarta"
FCM_CLIENT_EMAIL="firebase-adminsdk@sikoni-surakarta.iam.gserviceaccount.com"
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----"

# Client URLs (CORS & Redirection)
WEB_PUBLIC_URL="http://localhost:3000"
WEB_ADMIN_URL="http://localhost:3000/admin"
API_BASE_URL="http://localhost:4000/api/v1"

